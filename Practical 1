import pandas as pd
from sklearn.preprocessing import StandardScaler, LabelEncoder

df = pd.read_csv(r"C:\Users\Dell\Downloads\train.csv")
df.head()

print("Missing values before preprocessing")
print(df.isnull().sum())

required_columns = ['Survived', 'Pclass', 'Sex', 'Age', 'SibSp', 'Parch', 'Fare', 'Embarked', 'Cabin']
df = df[required_columns].copy()

df.columns = ['survived', 'pclass', 'sex', 'age', 'sibsp', 'parch', 'fare', 'embarked', 'deck']

df['age'] = df['age'].fillna(df['age'].median())
df['embarked'] = df['embarked'].fillna(df['embarked'].mode()[0])

df['Deck_Known'] = (df['deck'].notna()).astype(int)

df.head()

df.drop(columns=['deck'], inplace=True)

df.head()

le = LabelEncoder()
df['sex'] = le.fit_transform(df['sex'])

df = pd.get_dummies(df, columns=['embarked'], dtype=int)

scaler = StandardScaler()
df[['age']] = scaler.fit_transform(df[['age']])
df[['fare']] = scaler.fit_transform(df[['fare']])

print("Final Dataset:")
print(df)

print("\nMissing values after preprocessing:")
print(df.isnull().sum())
